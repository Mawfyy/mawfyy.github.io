---
import BaseLayout from '../layouts/BaseLayout.astro'

const media = [
  { name: "I got marriage on December 20 <3",
    images: [
      "/media/marriage/20250610_014141.jpg",
      "/media/marriage/20250610_014148.jpg"
    ]
  }
];
---
<BaseLayout title="Media" description="Photos and other media from my life.">
  <ul>
    {media.map(content => (
      <li class="grid text-center">
        <div class="flex justify-center space-x-2 m-2">
          {content.images.map(image_media => (
            <a
              href={image_media}
              target="_blank"
              rel="noopener noreferrer"
              class="block"
            >
              <img class="rounded-sm" src={image_media} width="200" height="200" loading="lazy" alt="marriage_photo" />
            </a>
          ))}
        </div>
        <p>{content.name}</p>
      </li>
    ))}
  </ul>
</BaseLayout>
